# 复制此文件为 .env 后按需修改
APP_NAME="Document Conversion API"
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 目录（默认使用相对路径；Docker 部署时挂载到 /data）
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
LOG_DIR=./logs

# 上传限制
MAX_UPLOAD_SIZE_MB=100
MAX_BATCH_FILES=50

# 日志
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_RETENTION_DAYS=30

# 任务 TTL（小时）
TASK_RESULT_TTL_HOURS=24

# CORS（生产环境应改为具体域名）
CORS_ORIGINS=["*"]

# ---- 数据库 / 认证 ----
DB_PATH=./data/app.db
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_SECONDS=86400
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
